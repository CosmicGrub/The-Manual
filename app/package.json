{
  "name": "the-manual-app",
  "version": "0.28.0",
  "private": true,
  "description": "Delivery app for The Manual — a self-taught, multi-tier coding/AI/hardware curriculum. Reads lesson content from ../content, tracks progress and spaced-repetition review locally.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:local-only": "next dev",
    "build": "velite build && node scripts/gen-precache-manifest.mjs && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "create-user": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.18",
    "@prisma/client": "^5.20.0",
    "better-auth": "^1.7.18",
    "gray-matter": "^4.0.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "velite": "^0.4.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "sharp": "0.35.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
