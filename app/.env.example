# Local-first default: a file-based SQLite DB checked in nowhere (git-ignored).
# Swap to a Postgres connection string here to move to a hosted/multi-user deployment —
# no schema or query code changes needed, only this value + `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Multi-user auth (Better Auth). No public signup — create accounts with
# `npm run create-user -- --email you@example.com --name "Your Name" --role admin`.
# BETTER_AUTH_SECRET signs session cookies —
# generate a real one per deployment with `openssl rand -base64 32`, never
# reuse this placeholder. BETTER_AUTH_URL is optional on a LAN (Better Auth
# derives the origin from the incoming request when unset); set it only if
# you reach this app through one fixed, known URL.
BETTER_AUTH_SECRET="replace-with-a-real-openssl-rand--base64-32-secret"
# BETTER_AUTH_URL="http://192.168.1.50:3000"
