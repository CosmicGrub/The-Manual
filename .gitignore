# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
app/.next/
app/out/
app/build/

# Env
.env
.env.local
.env.*.local
!.env.example

# Database (local-first SQLite dev db — never commit real progress data)
app/prisma/*.db
app/prisma/*.db-journal

# Velite generated content cache
app/.velite/

# Generated at build time from .velite/lessons.json (scripts/gen-precache-manifest.mjs) —
# regenerate via `npm run build`, never hand-edit or commit a stale copy.
app/public/precache-manifest.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
app/next-env.d.ts

# Auto-generated by `next dev`/`next build` (Next.js 16's agentRules feature) —
# regenerated every run, never hand-edit or commit a stale copy. This repo's
# own agent-facing docs live in MASTERFILE.md/CLAUDE.md instead.
app/AGENTS.md

# mobile/ (the Android fork, see MASTERFILE.md §3.6.5) — content/build output
# regenerated by `npm run build`, plus the native Android project Capacitor
# generates via `npx cap add android` (its own huge, regeneratable Gradle
# tree, not source we maintain by hand).
mobile/.velite/
mobile/dist/
mobile/android/
mobile/ios/

# NEVER commit the release-signing keystore or its password — this is the
# key that proves future updates to the sideloaded app actually come from
# the same source. Losing it isn't catastrophic (reinstall instead of
# update); leaking it is, since anyone holding it can sign a package Android
# will accept as a trusted update to this app on a device that already has
# it installed. See mobile/release-signing/README.md.
mobile/release-signing/*.keystore
mobile/release-signing/*password*
mobile/release-signing/*.apk
mobile/release-signing/*.apk.idsig
